{
  "name": "@orz/ui-markdown",
  "version": "0.1.0",
  "description": "GitHub-style markdown rendering on react-markdown, extended by markdown plugins and drawing code and embeds through @orz/ui-content",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orzFly/ui.git",
    "directory": "packages/ui-markdown"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@orz/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./lib/*": {
      "@orz/source": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@orz/ui": "workspace:^",
    "@orz/ui-content": "workspace:^",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "react-markdown": "^10.1.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@orz/ui": "workspace:*",
    "@orz/ui-content": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^21.0.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^5.0.5"
  }
}
