{
  "name": "@orz/themes",
  "version": "0.1.0",
  "description": "Theme palettes for @orz/ui and terminals as plain data, with light/dark palettes and variants",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orzFly/ui.git",
    "directory": "packages/themes"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "@orz/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./themes/*": {
      "@orz/source": "./src/themes/*.ts",
      "types": "./dist/themes/*.d.ts",
      "default": "./dist/themes/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "vitest": "^5.0.5"
  }
}
