{
  "name": "@orz/ui-mermaid",
  "version": "0.1.0",
  "description": "Mermaid diagrams drawn in the active @orz/ui theme, contributed to the @orz/ui-content registry",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orzFly/ui.git",
    "directory": "packages/ui-mermaid"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@orz/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@orz/ui": "workspace:^",
    "@orz/ui-content": "workspace:^",
    "react": "^19"
  },
  "dependencies": {
    "mermaid": "^12.2.0"
  },
  "devDependencies": {
    "@orz/themes": "workspace:*",
    "@orz/ui": "workspace:*",
    "@orz/ui-content": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^21.0.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^5.0.5"
  }
}
