{
  "name": "@orz/ui-json",
  "version": "0.1.1",
  "description": "A JSON tree viewer: JSON, JSONC, JSON5 and YAML, comments shown",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orzFly/ui.git",
    "directory": "packages/ui-json"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@orz/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./content": {
      "@orz/source": "./src/content.tsx",
      "types": "./dist/content.d.ts",
      "default": "./dist/content.js"
    },
    "./yaml": {
      "@orz/source": "./src/yaml.ts",
      "types": "./dist/yaml.d.ts",
      "default": "./dist/yaml.js"
    },
    "./yaml/content": {
      "@orz/source": "./src/yaml-content.tsx",
      "types": "./dist/yaml-content.d.ts",
      "default": "./dist/yaml-content.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@orz/ui": "workspace:^",
    "@orz/ui-content": "workspace:^",
    "lucide-react": "^1",
    "radix-ui": "^1",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2",
    "yaml": "^2.9.1"
  },
  "peerDependenciesMeta": {
    "@orz/ui-content": {
      "optional": true
    },
    "yaml": {
      "optional": true
    }
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.26"
  },
  "devDependencies": {
    "@orz/ui": "workspace:*",
    "@orz/ui-content": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^21.0.3",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
