{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "rootDir": "src",
    "outDir": "dist",
    // On source, @orz/ui's src/ would join this program and break rootDir;
    // `pnpm -r build` builds @orz/ui first, so its dist/ is there instead.
    "customConditions": []
  },
  "include": ["src"]
}
