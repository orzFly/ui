{
  "name": "@orz/ui-code",
  "version": "0.1.0",
  "description": "Highlighted code, diffs and a word differ",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orzFly/ui.git",
    "directory": "packages/ui-code"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@orz/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./word-diff": {
      "@orz/source": "./src/word-diff.ts",
      "types": "./dist/word-diff.d.ts",
      "default": "./dist/word-diff.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@orz/ui": "workspace:^",
    "@orz/ui-content": "workspace:^",
    "@pierre/diffs": "^1.6.1",
    "lucide-react": "^1",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@orz/themes": "workspace:*",
    "@orz/ui": "workspace:*",
    "@orz/ui-content": "workspace:*",
    "@pierre/diffs": "^1.6.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^21.0.3",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vitest": "^5.0.5"
  }
}
