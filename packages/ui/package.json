{
  "name": "@orz/ui",
  "version": "0.1.1",
  "description": "React primitives, patterns, hooks and the theme store",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/orzFly/ui.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "@orz/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "@orz/source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./hooks/*": {
      "@orz/source": "./src/hooks/*.ts",
      "types": "./dist/hooks/*.d.ts",
      "default": "./dist/hooks/*.js"
    },
    "./lib/*": {
      "@orz/source": "./src/lib/*.ts",
      "types": "./dist/lib/*.d.ts",
      "default": "./dist/lib/*.js"
    },
    "./theme": {
      "@orz/source": "./src/theme/index.ts",
      "types": "./dist/theme/index.d.ts",
      "default": "./dist/theme/index.js"
    },
    "./styles.css": "./styles.css",
    "./theme.css": "./theme.css",
    "./styles/*.css": "./styles/*.css"
  },
  "files": [
    "dist",
    "styles.css",
    "theme.css",
    "styles",
    "vendor"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "lucide-react": "^1",
    "overlayscrollbars": "^2",
    "radix-ui": "^1",
    "react": "^19",
    "react-dom": "^19",
    "sonner": "^2"
  },
  "peerDependenciesMeta": {
    "overlayscrollbars": {
      "optional": true
    }
  },
  "dependencies": {
    "@fontsource-variable/noto-sans": "^5.3.0",
    "@fontsource-variable/noto-sans-mono": "^5.3.0",
    "@orz/query": "workspace:^",
    "@orz/themes": "workspace:^",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "culori": "^4.0.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/culori": "^4.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^21.0.3",
    "lucide-react": "^1.31.0",
    "overlayscrollbars": "^2.16.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.16.2",
    "sonner": "^2.0.8",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
