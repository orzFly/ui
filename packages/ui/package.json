{
  "name": "@orz/ui",
  "version": "0.0.0",
  "description": "Shared React components, hooks and theme for orz projects",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "github:orzFly/orzui",
    "directory": "packages/ui"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "happy-dom": "^21.0.3",
    "vitest": "^5.0.5"
  }
}
