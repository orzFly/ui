{
  "name": "@orz/ui-codemirror",
  "version": "0.0.0",
  "description": "CodeMirror code and markdown editors, completion extensions and slash-command editing",
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "github:orzFly/orzui",
    "directory": "packages/ui-codemirror"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./components/*": {
      "@orz/source": "./src/components/*.tsx",
      "types": "./dist/components/*.d.ts",
      "default": "./dist/components/*.js"
    },
    "./extensions/*": {
      "@orz/source": "./src/extensions/*.ts",
      "types": "./dist/extensions/*.d.ts",
      "default": "./dist/extensions/*.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@orz/ui": "workspace:^",
    "react": "^19",
    "react-dom": "^19"
  },
  "dependencies": {
    "@lezer/json": "^1.0.3",
    "@lezer/markdown": "^1.7.2",
    "@orz/query": "workspace:^"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.9",
    "@lezer/highlight": "^1.2.3",
    "@orz/ui": "workspace:^",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "happy-dom": "^21.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
